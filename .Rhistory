cat("=== mortality_data ===\n")
cat("Dims:", dim(mortality_data), "\n")
cat("Cols:", paste(names(mortality_data), collapse=" | "), "\n")
cat("NUTS sample:", paste(head(unique(mortality_data$NUTS), 5), collapse=", "), "\n")
cat("Geschlecht:", paste(unique(mortality_data$Geschlecht), collapse=", "), "\n\n")
cat("=== germany_districts ===\n")
cat("Class:", class(germany_districts), "\n")
cat("Cols:", paste(names(germany_districts), collapse=" | "), "\n")
cat("nuts_id sample:", paste(head(unique(germany_districts$nuts_id), 10), collapse=", "), "\n")
cat("\n=== Join test ===\n")
sa <- germany_districts %>%
mutate(nuts_id = toupper(trimws(nuts_id))) %>%
filter(substr(nuts_id, 1, 3) == "DEE", nuts_id != "DEE0")
cat("SA rows after filter:", nrow(sa), "\n")
mort <- mortality_data %>%
filter(NUTS != "DEE0", Jahr == max(Jahr), Geschlecht == "Zusammen") %>%
mutate(NUTS = toupper(trimws(NUTS)))
cat("Mort rows:", nrow(mort), "\n")
joined <- sa %>% left_join(mort, by = c("nuts_id" = "NUTS"))
cat("Joined rows:", nrow(joined), "\n")
cat("NAs in value:", sum(is.na(joined[[input$mort_cause]])), "\n")
cat("geometry col name:", attr(germany_districts, "sf_column"), "\n")
# Check if it's 'geometry' or 'geo' (you have BOTH 'geo' and 'geometry' columns!)
cat("All cols:", paste(names(germany_districts), collapse=", "), "\n")
# Check actual geometry column
sa <- germany_districts %>%
mutate(nuts_id = toupper(trimws(nuts_id))) %>%
filter(substr(nuts_id, 1, 3) == "DEE", nuts_id != "DEE0")
cat("Active geometry col:", attr(sa, "sf_column"), "\n")
cat("CRS:", st_crs(sa)$epsg, "\n")
runApp()
runApp()
runApp()
runApp()
germany_districts |> filter(substr(nuts_id, 1, 3) == "DEE") |> pull(nuts_id)
mort_map_data_test <- germany_districts |>
mutate(nuts_id = toupper(trimws(nuts_id))) |>
filter(substr(nuts_id, 1, 3) == "DEE", nuts_id != "DEE0")
cat("Rows:", nrow(mort_map_data_test), "\n")
plot(st_geometry(st_transform(mort_map_data_test, 4326)))
runApp()
