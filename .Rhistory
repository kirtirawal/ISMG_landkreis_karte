id = ns("headingMortality"),
tags$button(
class = "accordion-button collapsed",
type = "button",
`data-bs-toggle` = "collapse",
`data-bs-target` = paste0("#", ns("collapseMortality")),
`aria-expanded` = "false",
`aria-controls` = ns("collapseMortality"),
"⚕️ Sterbefallstatistik – ICD-10 Todesursachen"
)
),
tags$div(
id = ns("collapseMortality"),
class = "accordion-collapse collapse",
`aria-labelledby` = ns("headingMortality"),
tags$div(
class = "accordion-body",
# --- Info box ---
div(
class = "info-box",
tags$p(
class = "mb-0",
tags$strong("💡 Anleitung: "),
"Wählen Sie eine Todesursache (ICD-10), ein Jahr und ein Geschlecht.
Klicken Sie auf eine Region in der Karte, um die Zeitreihe im Diagramm zu sehen."
)
),
# --- Controls row ---
fluidRow(
# ICD-10 cause selector
column(
width = 12, md = 5,
tags$label(class = "form-label fw-bold", `for` = ns("mort_cause"),
"🦠 Todesursache (ICD-10):"),
selectInput(ns("mort_cause"), NULL,
choices  = NULL,   # filled server-side
width    = "100%",
selectize = FALSE)
),
# Gender selector
column(
width = 6, md = 3,
tags$label(class = "form-label fw-bold", `for` = ns("mort_gender"),
"👤 Geschlecht:"),
selectInput(ns("mort_gender"), NULL,
choices  = c("Zusammen", "männlich", "weiblich"),
selected = "Zusammen",
width    = "100%")
),
# Year selector
column(
width = 6, md = 4,
tags$label(class = "form-label fw-bold", `for` = ns("mort_year"),
"📅 Jahr (Karte):"),
selectInput(ns("mort_year"), NULL,
choices  = NULL,   # filled server-side
selected = NULL,
width    = "100%")
)
),
# --- Color palette ---
fluidRow(
column(
width = 12,
tags$label(class = "form-label fw-bold", `for` = ns("mort_palette"),
"🎨 Map Color Palette:"),
selectInput(ns("mort_palette"), NULL,
choices  = c("Green" = "green", "Blue" = "blue",
"Red"   = "red",   "Viridis" = "viridis",
"Plasma" = "plasma"),
selected = "blue",
width    = "100%")
)
),
tags$hr(class = "my-2"),
# --- Map + Bar ---
fluidRow(
class = "g-0 plots-row",
column(
width = 12, md = 7,
div(class = "plot-container map-girafe",
girafeOutput(ns("mort_map"), width = "100%", height = "300px"))
),
column(
width = 12, md = 5,
div(class = "plot-container bar-girafe",
girafeOutput(ns("mort_bar"), width = "100%", height = "300px"))
)
),
tags$hr(class = "my-2"),
# --- Summary table ---
fluidRow(
column(
width = 12,
tags$h6(class = "fw-bold mt-2",
"📋 Detailtabelle – alle Regionen (gewähltes Jahr & Geschlecht)"),
div(
style = "overflow-x: auto;",
tableOutput(ns("mort_table"))
)
)
)
)
)
)
)
}
mod_mortality_server <- function(id) {
moduleServer(id, function(input, output, session) {
# ── 1. Load & reshape mortality data ─────────────────────────────────────
mortality_long <- reactive({
req(exists("mortality_data"))   # loaded in global.R (see below)
mortality_data %>%
pivot_longer(
cols      = -c(NUTS, Jahr, Region, Geschlecht),
names_to  = "cause",
values_to = "deaths"
) %>%
mutate(
deaths = suppressWarnings(as.numeric(deaths)),
Jahr   = as.character(Jahr)
)
})
# ── 2. Populate dropdowns once data is available ──────────────────────────
observe({
req(mortality_long())
causes <- sort(unique(mortality_long()$cause))
years  <- sort(unique(mortality_long()$Jahr), decreasing = TRUE)
updateSelectInput(session, "mort_cause",
choices  = causes,
selected = causes[1])
updateSelectInput(session, "mort_year",
choices  = years,
selected = years[1])
})
# ── 3. Join mortality data with spatial geometry ──────────────────────────
mort_geo <- reactive({
req(mortality_long(), input$mort_cause, input$mort_gender)
mortality_long() %>%
filter(
cause      == input$mort_cause,
Geschlecht == input$mort_gender
) %>%
inner_join(
germany_districts %>% select(nuts_id, nuts_name, geometry),
by = c("NUTS" = "nuts_id")
) %>%
st_as_sf()
})
# ── 4. Map data: single year ──────────────────────────────────────────────
mort_map_data <- reactive({
req(mort_geo(), input$mort_year)
mort_geo() %>% filter(Jahr == input$mort_year)
})
# ── 5. Selected region (from map click or default) ────────────────────────
selected_mort_region <- reactive({
clicked <- input$mort_map_selected
if (!is.null(clicked) && clicked != "") {
clicked
} else {
df <- mort_map_data()
if (nrow(df) > 0) df$nuts_name[1] else NULL
}
})
# ── 6. Color palette helper ───────────────────────────────────────────────
mort_palette <- reactive({
switch(
input$mort_palette,
"green"   = scale_fill_gradient(low = "#e5f5e0", high = "#31a354",  na.value = "grey80"),
"blue"    = scale_fill_gradient(low = "#deebf7", high = "#3182bd",  na.value = "grey80"),
"red"     = scale_fill_gradient(low = "#fee0d2", high = "#de2d26",  na.value = "grey80"),
"viridis" = scale_fill_viridis_c(option = "viridis", na.value = "grey80"),
"plasma"  = scale_fill_viridis_c(option = "plasma",  na.value = "grey80"),
scale_fill_gradient(low = "#deebf7", high = "#3182bd", na.value = "grey80")
)
})
# ── 7. Interactive map ────────────────────────────────────────────────────
output$mort_map <- renderGirafe({
df <- mort_map_data()
validate(need(nrow(df) > 0, "Keine Daten für diese Auswahl gefunden."))
gg <- ggplot(df) +
geom_sf_interactive(
aes(
geometry = geometry,
fill     = deaths,
tooltip  = glue(
"<b>{nuts_name}</b><br>",
"Jahr: {Jahr}<br>",
"Geschlecht: {Geschlecht}<br>",
"Sterbefälle: {format(deaths, big.mark='.', decimal.mark=',')}"
),
data_id  = nuts_name
),
color     = "black",
linewidth = 0.3
) +
mort_palette() +
theme_void() +
labs(
fill  = "Sterbefälle",
title = paste0(input$mort_year, " | ", input$mort_gender)
) +
theme(
plot.title  = element_text(size = 12, face = "bold"),
legend.position = "bottom",
legend.key.width = unit(1.5, "cm")
)
girafe(
ggobj   = gg,
width_svg  = 10,
height_svg = 6,
options = list(
opts_hover(css     = "stroke:red;stroke-width:2;"),
opts_selection(type = "single"),
opts_zoom(max = 2)
)
)
})
# ── 8. Time-series bar chart ──────────────────────────────────────────────
output$mort_bar <- renderGirafe({
region <- selected_mort_region()
req(region)
bar_df <- mort_geo() %>%
filter(nuts_name == region) %>%
arrange(Jahr)
validate(need(nrow(bar_df) > 0, "Keine Zeitreihendaten für diese Region."))
gg_bar <- ggplot(bar_df, aes(x = Jahr, y = deaths, fill = Jahr)) +
geom_col_interactive(
aes(tooltip = glue("Jahr: {Jahr}<br>Sterbefälle: {format(deaths, big.mark='.', decimal.mark=',')}")),
width = 0.65,
show.legend = FALSE
) +
theme_minimal(base_size = 11) +
labs(
title = region,
x     = "Jahr",
y     = "Sterbefälle"
) +
theme(
plot.title    = element_text(size = 11, face = "bold"),
axis.text.x   = element_text(angle = 45, hjust = 1, size = 8)
)
girafe(
ggobj      = gg_bar,
width_svg  = 8,
height_svg = 5,
options    = list(opts_hover(css = "fill:orange;"))
)
})
# ── 9. Summary table ─────────────────────────────────────────────────────
output$mort_table <- renderTable({
req(mort_map_data())
mort_map_data() %>%
st_drop_geometry() %>%
select(Region, NUTS, Geschlecht, Jahr, cause, deaths) %>%
arrange(Region) %>%
rename(
"Region"       = Region,
"NUTS-ID"      = NUTS,
"Geschlecht"   = Geschlecht,
"Jahr"         = Jahr,
"Todesursache" = cause,
"Sterbefälle"  = deaths
)
},
striped   = TRUE,
hover     = TRUE,
bordered  = TRUE,
width     = "100%"
)
})
}
runApp()
runApp()
runApp()
rsconnect::deployApp(
appDir  = ".",
appName = "landkreis_dashboard_experimental",
account = "kirtirawal",
forceUpdate = TRUE
)
runApp()
